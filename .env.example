# Application
PORT=3000
NODE_ENV=development

# Database configuration
# Supported drivers: sqlite3, mysql2, pg
DB_CLIENT=sqlite3
DB_FILENAME=./sites/current/site.db

# If using MySQL/MariaDB or PostgreSQL:
# DB_CLIENT=mysql2
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=password
# DB_NAME=frappe_db

# Redis
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
