{
  "name": "frappe-nodejs",
  "version": "0.1.0",
  "description": "Metadata-driven Frappe Framework ported to Node.js / NestJS",
  "author": "",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/meta/doctypes', 'dist/meta/doctypes', { recursive: true, errorOnExist: false }); require('fs').mkdirSync('dist/desk', { recursive: true }); require('fs').copyFileSync('src/desk/desk.html', 'dist/desk/desk.html'); require('fs').cpSync('src/modules', 'dist/modules', { recursive: true, errorOnExist: false })\"",
    "start": "node dist/main.js",
    "start:dev": "node --watch --require @swc-node/register src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "bullmq": "^6.3.9",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "ioredis": "^5.5.0",
    "knex": "^3.1.0",
    "mysql2": "^3.24.4",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4",
    "sqlite3": "^6.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.6",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.12",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sqlite3",
      "esbuild"
    ]
  }
}
